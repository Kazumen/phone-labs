# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/phone_labs?retryWrites=true&w=majority

# Secret key for signing JWT tokens — replace with any long random string
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Port the server listens on
PORT=3000
